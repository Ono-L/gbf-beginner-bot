# Cloudflare Workers ローカル開発用シークレット設定テンプレート
# このファイルを `.dev.vars` にコピーして実際の値を設定してください。
# `.dev.vars` は `.gitignore` に含まれており、絶対に Git にコミットしないでください。

# Google AI Studio (Gemini API) の API キー
GEMINI_API_KEY=your_gemini_api_key_here

# Discord Developer Portal -> General Information -> Public Key (16進数64文字)
DISCORD_PUBLIC_KEY=your_discord_public_key_here

# Discord Developer Portal -> Bot -> Token（コマンド登録スクリプトや必要に応じて使用）
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Developer Portal -> General Information -> Application ID
DISCORD_APPLICATION_ID=your_discord_application_id_here

# 任意: 開発用サーバーに即時反映したい場合のみ指定（未指定ならグローバル登録）
# DISCORD_GUILD_ID=your_dev_guild_id_here
